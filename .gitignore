# --- 构建产物（可重新产出）---
LprDemo/entry/build/
LprDemo/entry/.cxx/
LprDemo/.hvigor/
LprDemo/.idea/
LprDemo/oh_modules/
LprDemo/entry/oh_modules/
*.hap
*.har

# --- 模型二进制（由 tools/convert_ms.sh 从 ONNX 重新产出）---
*.ms
*.om
*.omc
*.onnx
*.pt
*.ncnn.bin
*.ncnn.param

# --- _veh/ 探索目录的处置（T7 定案）---
# 脚本与证据（*.py / *.json / *.txt / 截图）**入库** —— 它们是可复现的依据；
# 模型二进制（.onnx/.pt/.ms）与转换中间产物**不入库**（上面那组通配已覆盖前者）。
# mschck/ 是 ms_fidelity_check.py 的 --outdir 产物（input_nhwc.bin / golden_nchw.bin /
# ref.json），可由 .onnx 重新生成，所以不占仓库体积。
_veh/mscheck/

# T8 新增两类 vendored 依赖，同样不入库：
#   _veh/pylibs/       —— 旧版 setuptools（--target --no-deps 装的），只为补
#                         `pkg_resources`；setuptools >= 81 起不再随包发布它，
#                         而 yolov5 7.0 仍 `import pkg_resources as pkg`。
#                         一行命令即可重建（见 _veh/export_yolov5_v7.py 注释）。
#   _veh/third_party/  —— yolov5 v7.0 源码浅克隆（GPL-3.0）。上游只支持
#                         「仓库根目录在 sys.path 上」这一种用法，PyPI 轮子不可用。
_veh/pylibs/
_veh/third_party/

# 原始全量 hilog 转储（`hdc shell hilog -x` 直出，MB 量级）不入库 ——
# 惯例是只入库**过滤后**的 devlog（`_veh/devlog_*.txt`，KB 量级）。
# 过滤命令写在各脚本/日志注释里，可复现。
_veh/*_raw.txt

# --- 签名材料（不入库）---
# 由 tools/make_signing_material.sh 生成到 .signing/。
# 注意 pw.txt 存的是**明文**密钥库口令（供 hap-sign-tool 使用），绝不能入库。
*.p12
*.cer
*.p7b
*.csr
pw.txt
/.signing/

# --- DDK（匿名可下，含 >100MB 单文件）---
ddk/

# --- 系统 ---
Thumbs.db
desktop.ini
.DS_Store

# --- Python 字节码 ---
# 曾被误跟踪过一个 tools/__pycache__/*.pyc（2026-09-22 清掉）。
# 它是**本机字节码缓存**，跨机器/跨解释器版本无意义，且会让
# 「按对象直推 API」的推送方式 422（远端解不出这个 blob）。
__pycache__/
*.py[cod]

# --- 运行时临时产物 ---
# `uitest dumpLayout` 的界面树快照，由 tools/run_camera_sweep.ps1 写入。
# 它们是**运行时读取的中间物**（脚本靠它找控件坐标），不是证据，不入库。
# 证据在 evidence/ —— 那个目录是**故意跟踪**的（见已有 rq4_thermal.* 等）。
_scratch/
